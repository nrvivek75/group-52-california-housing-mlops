# Environment variables for California Housing MLOps Project

# MLflow Configuration
MLFLOW_TRACKING_URI=file:./mlruns
MLFLOW_EXPERIMENT_NAME=california_housing_experiment
MLFLOW_REGISTERED_MODEL_NAME=california_housing_best_model

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_LOG_LEVEL=INFO

# Database Configuration
DATABASE_PATH=logs/predictions.db

# Model Configuration
MODEL_PATH=models/best_model.pkl
SCALER_PATH=models/scaler.pkl

# Docker Configuration
DOCKER_IMAGE_NAME=california-housing-mlops
DOCKER_TAG=latest

# GitHub Actions Secrets (set these in your repository)
# DOCKER_USERNAME=your-dockerhub-username
# DOCKER_PASSWORD=your-dockerhub-token
# EC2_HOST=your-ec2-ip
# EC2_USERNAME=ubuntu
# EC2_SSH_KEY=your-private-key

# Optional: External MLflow tracking server
# MLFLOW_TRACKING_URI=http://your-mlflow-server:5000

# Optional: Model monitoring
ENABLE_MODEL_MONITORING=true
MODEL_DRIFT_THRESHOLD=0.1 
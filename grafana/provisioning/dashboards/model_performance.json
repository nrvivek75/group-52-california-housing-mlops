{
  "dashboard": {
    "id": null,
    "title": "Model Performance Dashboard",
    "tags": ["mlops", "models"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Model RMSE Comparison",
        "type": "bargraph",
        "targets": [
          {
            "expr": "model_rmse",
            "refId": "A"
          }
        ]
      },
      {
        "id": 2,
        "title": "Model R² Score",
        "type": "stat",
        "targets": [
          {
            "expr": "model_r2_score",
            "refId": "A"
          }
        ]
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "30s"
  },
  "overwrite": true
} 